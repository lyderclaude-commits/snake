# /srv/wakabi-boost/wakabi.env — lu par systemd, jamais versionné.
#
#   sudo install -o wakabi -g wakabi -m 600 wakabi.env /srv/wakabi-boost/wakabi.env
#
# Le mode 600 n'est pas cosmétique : ce fichier grandira (SMTP, clés).

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# L'adresse publique. Incrustée dans le QR de CHAQUE badge, donc dans un
# fichier que l'invité garde. Se tromper ici produit des badges faux pour
# toujours — l'application refuse de démarrer un badge sans cette valeur.
WAKABI_BASE_URL=https://boost.wakabileguide.com

# Hors du dossier de l'application, pour survivre aux redéploiements.
WAKABI_DB=/var/lib/wakabi-boost/wakabi.sqlite
WAKABI_UPLOADS=/var/lib/wakabi-boost/uploads
