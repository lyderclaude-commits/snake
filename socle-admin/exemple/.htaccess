# Le site exemple du socle — tout ce qui n'est pas un fichier réel passe par index.php.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
# Si le site vit dans un sous-dossier, décommentez et adaptez :
# RewriteBase /sous-dossier/

# Forcer HTTPS (décommentez une fois le certificat en place) :
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Le code, les données et la configuration ne sont jamais servis.
RewriteRule ^(app|donnees|outils)(/|$) - [F,L]
# Le socle d'administration : seules ses feuilles de style, scripts et images sont publics.
RewriteRule ^socle/(?!assets/) - [F,L]
RewriteRule ^config\.php$ - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|jpe?g|png|gif|webp|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
