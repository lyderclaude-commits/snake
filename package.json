{
  "name": "wakabi-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Générateur de décors et de visuels personnalisés pour Wakabi Le Guide",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/core/template.schema.test.ts",
    "frames": "tsx scripts/build-frames.ts",
    "demo": "tsx scripts/build-demo.ts && tsc -p tsconfig.demo.json",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "purge": "tsx --conditions=react-server scripts/purge.ts",
    "e2e": "tsx scripts/e2e-app.ts",
    "e2e:full": "tsx scripts/e2e-full.ts",
    "package:cpanel": "npm run build && tsx scripts/package-cpanel.ts",
    "php:bundle": "esbuild php/studio/entry.ts --bundle --format=iife --target=es2019 --minify --outfile=php/public/studio.js --alias:@=./src && esbuild php/studio/apercu.ts --bundle --format=iife --target=es2019 --minify --outfile=php/public/apercu.js --alias:@=./src",
    "php:serve": "php -S 127.0.0.1:3600 -t php",
    "php:e2e": "tsx scripts/e2e-php.ts",
    "php:verifier": "tsx scripts/verifier-qr.ts && tsx scripts/verifier-gabarit.ts && tsx scripts/verifier-courriel.ts",
    "package:php": "tsx scripts/package-php.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "better-sqlite3": "^11.10.0",
    "next": "^15.5.24",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.18.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.10",
    "playwright-core": "^1.55.0",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
