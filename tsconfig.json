{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // src/demo est une cible de build à part (scripts/build-demo.ts, esbuild) et
  // s'appuie sur un fichier généré, absent d'un dépôt fraîchement cloné. Le
  // laisser ici ferait échouer `next build` sur une case à cocher qui ne
  // concerne pas l'application. Il garde son propre typage : tsconfig.demo.json.
  "exclude": ["node_modules", "src/demo", "dist-cpanel", "dist-php"]
}
